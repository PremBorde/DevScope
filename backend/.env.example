# Database
DATABASE_URL=postgres://user:password@localhost:5432/devscope

# Redis (optional; in-memory fallback if unset)
REDIS_URL=redis://localhost:6379

# Server
NODE_ENV=development
PORT=3001

# Session (required in production)
SESSION_SECRET=a-very-long-and-secure-random-string

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# GitHub API (optional; higher rate limits)
GITHUB_TOKEN=

# Gemini (set base URL from Google GenAI docs for your region)
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=
# Alias for the same key (optional)
GEMINI_API_KEY=

# Split deploy: browser origin(s) allowed to call the API with credentials (comma-separated, full origins)
ALLOWED_ORIGINS=http://localhost:5173

# Split deploy: SPA URL after GitHub OAuth (no trailing slash). Omit when API serves the frontend.
FRONTEND_URL=http://localhost:5173

# Replit legacy (optional)
REPLIT_DOMAINS=

# Expose /api/debug-score in production (default off)
ENABLE_DEBUG_SCORE=false
