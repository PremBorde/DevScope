# Database
DATABASE_URL=postgres://user:password@localhost:5432/devscope

# Redis (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379

# GitHub OAuth
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# GitHub API (optional but highly recommended for production rate limits)
GITHUB_TOKEN=your_personal_access_token

# Gemini AI
AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_key

# Session
SESSION_SECRET=a-very-long-and-secure-random-string

# Environment
NODE_ENV=development
PORT=3001
