# Monorepo: prefer copying `frontend/.env.example` and `backend/.env.example` into local `.env` files.
# See README for split (Vercel + API) vs combined deployment.

# Database
DATABASE_URL=postgres://user:password@localhost:5432/devscope

# Redis (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379

# GitHub OAuth
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# GitHub API (optional but highly recommended for production rate limits)
GITHUB_TOKEN=your_personal_access_token

# Gemini AI (backend reads these; GEMINI_API_KEY is an optional alias)
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_key
GEMINI_API_KEY=

# Session
SESSION_SECRET=a-very-long-and-secure-random-string

# Split deploy: frontend origin(s) for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Split deploy: SPA base URL for OAuth redirects (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Frontend build (Vercel): API origin, no trailing slash
VITE_API_URL=

# Environment
NODE_ENV=development
PORT=3001

# Production only: set ENABLE_DEBUG_SCORE=true to mount /api/debug-score
ENABLE_DEBUG_SCORE=false
